            path.AddEllipse(0, 0, pnlLedStatus.Width, pnlLedStatus.Height);

            var oldRegion = pnlLedStatus.Region;
            pnlLedStatus.Region = new Region(path);
            oldRegion?.Dispose();
            path.Dispose();
        }

